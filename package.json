{
  "name": "codex-consultant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A read-only Codex app-server bridge exposed as local stdio MCP tools.",
  "license": "MIT",
  "author": {
    "name": "Ahmed Yosry",
    "url": "https://github.com/amu3dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amu3dev/codex-consultant.git"
  },
  "homepage": "https://github.com/amu3dev/codex-consultant#readme",
  "bugs": {
    "url": "https://github.com/amu3dev/codex-consultant/issues"
  },
  "keywords": [
    "codex",
    "mcp",
    "model-context-protocol",
    "app-server",
    "stdio",
    "consultant",
    "read-only"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build && npm run verify:mcp",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "smoke:app-server": "tsx scripts/app-server-smoke.ts",
    "smoke:wrapper": "tsx scripts/wrapper-smoke.ts",
    "smoke:continue": "tsx scripts/continue-smoke.ts",
    "verify:mcp": "node scripts/mcp-stdio-check.mjs",
    "smoke:mcp": "node scripts/real-mcp-call.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0-beta.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
